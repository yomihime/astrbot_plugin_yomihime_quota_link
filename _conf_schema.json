{
  "timeout_seconds": {
    "description": "单个账户查询的最长等待秒数",
    "type": "float",
    "default": 8.0
  },
  "total_timeout_seconds": {
    "description": "一次查询所有目标的最长等待秒数",
    "type": "float",
    "default": 30.0
  },
  "cache_ttl_seconds": {
    "description": "成功查询结果的缓存秒数",
    "type": "float",
    "default": 60.0
  },
  "max_concurrency": {
    "description": "同时查询的账户数上限",
    "type": "int",
    "default": 4
  },
  "allow_group_queries": {
    "description": "是否允许在群聊查询",
    "type": "bool",
    "default": false
  },
  "group_allowed_user_ids": {
    "description": "群聊查询白名单用户 ID",
    "type": "list",
    "default": []
  },
