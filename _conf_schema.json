{
  "timeout_seconds": {
    "description": "单个账户查询的最长等待秒数",
    "type": "float",
    "default": 8.0
  },
  "total_timeout_seconds": {
    "description": "一次查询所有目标的最长等待秒数",
    "type": "float",
    "default": 30.0
  },
  "cache_ttl_seconds": {
    "description": "成功查询结果的缓存秒数",
    "type": "float",
    "default": 60.0
  },
  "max_concurrency": {
    "description": "同时查询的账户数上限",
    "type": "int",
    "default": 4
  },
  "allow_group_queries": {
    "description": "是否允许在群聊查询",
    "type": "bool",
    "default": false
  },
  "group_allowed_user_ids": {
    "description": "群聊查询白名单用户 ID",
    "type": "list",
    "default": []
  },
  "providers": {
    "description": "配置多个供应商账户；凭据建议使用 ${ENV_VAR} 环境变量引用。DeepSeek 用 API Key；百炼现金余额用独立阿里云 AccessKey，DashScope Key 不可替代；兼容接口仅接受 HTTPS 余额端点。",
    "type": "template_list",
    "default": [],
    "templates": {
      "provider_account": {
        "name": "API 账户",
        "hint": "Grsai 余额接口的目标节点、认证和响应结构仍待确认；请先按对应文档填写通用兼容配置。不要把聊天端点用作余额端点。",
        "display_item": "display_name",
        "items": {
          "id": {
            "description": "账户唯一 ID",
            "type": "string",
            "default": ""
          },
          "type": {
            "description": "供应商类型",
            "type": "string",
            "default": "deepseek",
            "options": ["alibaba_bailian", "deepseek", "openai_compatible"]
          },
          "display_name": {
            "description": "显示名称",
            "type": "string",
            "default": ""
          },
          "aliases": {
            "description": "用于命令和自然语言匹配的其他名称",
            "type": "list",
            "default": []
          },
          "enabled": {
            "description": "启用此账户",
            "type": "bool",
            "default": true
          },
          "timeout_seconds": {
            "description": "账户查询超时秒数",
            "type": "float",
            "default": 8.0
          },
          "cache_ttl_seconds": {
            "description": "账户成功结果缓存秒数",
            "type": "float",
            "default": 60.0
          },
          "auth": {
            "description": "账户凭据",
            "type": "object",
            "items": {
              "api_key": {
                "description": "DeepSeek 或兼容余额接口 API Key；不要用于阿里云 BSS",
                "type": "string",
                "default": "",
                "secret": true
              },
              "access_key_id": {
                "description": "阿里云 RAM AccessKey ID（独立于 DashScope API Key）",
                "type": "string",
                "default": "",
                "secret": true
              },
              "access_key_secret": {
                "description": "阿里云 RAM AccessKey Secret",
                "type": "string",
                "default": "",
                "secret": true
              },
              "security_token": {
                "description": "可选的阿里云 STS Security Token",
                "type": "string",
                "default": "",
                "secret": true
              }
            }
          },
          "endpoint": {
            "description": "兼容供应商的只读余额端点；必须使用 HTTPS",
            "type": "object",
            "items": {
              "url": {
                "description": "完整 HTTPS 余额 URL（不含 query、凭据或 fragment）",
                "type": "string",
                "default": ""
              },
              "base_url": {
                "description": "HTTPS 服务根地址；可与 path 配合",
                "type": "string",
                "default": ""
              },
              "path": {
                "description": "经文档确认的只读余额路径",
                "type": "string",
                "default": ""
              },
              "method": {
                "description": "只允许 GET 或已确认无副作用的 POST",
                "type": "string",
                "default": "GET",
                "options": ["GET", "POST"]
              },
              "auth_mode": {
                "description": "API Key 认证位置",
                "type": "string",
                "default": "bearer",
                "options": ["bearer", "header", "query"]
              },
              "auth_name": {
                "description": "auth_mode 为 header 或 query 时的名称",
                "type": "string",
                "default": ""
              },
              "json_body": {
                "description": "仅用于有文档依据的只读 POST；静态 JSON 对象，不支持模板或凭据",
                "type": "object",
                "items": {},
                "default": {}
              }
            }
          },
          "response_mapping": {
            "description": "使用 JSON Pointer 映射供应商的余额和可选状态字段；amount_path 必需",
            "type": "dict",
            "items": {
              "amount_path": {"description": "必需的主余额路径，例如 /data/remaining", "type": "string", "default": ""},
              "total_path": {"description": "可选总量路径", "type": "string", "default": ""},
              "remaining_path": {"description": "可选剩余量路径", "type": "string", "default": ""},
              "used_path": {"description": "可选已用量路径", "type": "string", "default": ""},
              "unit": {"description": "固定单位标签：CNY/USD/JPY/credit/credits/tokens/requests/custom；unit_path 存在时必填", "type": "string", "default": "custom"},
              "unit_path": {"description": "可选 JSON Pointer；运行时值必须与固定 unit 一致", "type": "string", "default": ""},
              "kind": {"description": "固定余额类别", "type": "string", "default": "custom"},
              "kind_path": {"description": "可选余额类别 JSON Pointer；仅接受 cash/quota/free_quota/subscription/credits/usage/custom", "type": "string", "default": ""},
              "status_path": {"description": "可选账户状态 JSON Pointer", "type": "string", "default": ""},
              "status_values": {"description": "供应商状态值到 available/unavailable/partial/unknown 的映射", "type": "dict", "items": {}, "default": {}},
              "expires_at_path": {"description": "可选到期时间 JSON Pointer", "type": "string", "default": ""},
              "expiry_path": {"description": "expires_at_path 的兼容别名", "type": "string", "default": ""},
              "success_path": {"description": "可选业务成功字段路径", "type": "string", "default": ""},
              "success_value": {"description": "success_path 对应的成功值", "type": "string", "default": ""},
              "failure_path": {"description": "可选业务失败字段路径", "type": "string", "default": ""},
              "failure_value": {"description": "failure_path 对应的失败值", "type": "string", "default": ""}
            },
            "default": {}
          }
        }
      }
    }
  }
}
